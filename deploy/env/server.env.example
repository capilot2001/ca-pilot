# server environment — copy to server.env and fill in.
# Consumed by app/settings.py (pydantic-settings); every var is optional and
# falls back to the default shown.

# SQLite file (ADR-0007). On Railway / Cloud Run point this at a MOUNTED VOLUME —
# the container filesystem is ephemeral and the client list dies with the
# instance otherwise.
LEDGERFLOW_DB=/data/ledgerflow.db

# Browser origins allowed to call the API (the Next.js client). Comma-separated.
CORS_ORIGINS=http://localhost:3000

# OCR mode. "in_process" (Phase-0 default) runs the reading pipeline inside the
# server. "http" (post-migration) calls a split-out OCR service at
# OCR_SERVICE_URL.
OCR_MODE=in_process
# OCR_SERVICE_URL=https://ocr.example.com

# Reading provider (forward config; reading uses Gemini on Vertex AI).
LLM_PROVIDER=gemini

# --- Google Cloud credentials (Cloud Vision OCR + Gemini on Vertex AI) ---
# Cloud Run: use the runtime service account (ADC) and leave the key unset.
# Elsewhere: mount a service-account key and point at it.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project    # ADC usually supplies this on GCP

# --- reading pipeline knobs (optional; defaults match v1) ---
# LEDGERFLOW_LLM=1                 # 0 forces the parser-only path (no Gemini)
# LEDGERFLOW_LLM_MODEL=gemini-2.5-flash
# LEDGERFLOW_LLM_LOCATION=global
